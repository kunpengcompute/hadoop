diff --git a/hadoop-hdfs-project/hadoop-hdfs-native-client/src/main/native/libhdfs/os/thread_local_storage.h b/hadoop-hdfs-project/hadoop-hdfs-native-client/src/main/native/libhdfs/os/thread_local_storage.h
--- a/hadoop-hdfs-project/hadoop-hdfs-native-client/src/main/native/libhdfs/os/thread_local_storage.h	(revision 17f4f317d8c70fcb839a2ea6a9f42b974802afbd)
+++ b/hadoop-hdfs-project/hadoop-hdfs-native-client/src/main/native/libhdfs/os/thread_local_storage.h	(revision d036f07f27961d12bc57103fa5088ea031ebceae)
@@ -27,6 +27,7 @@
  */
 
 #include <jni.h>
+#include <stdbool.h>
 
 /*
  * Most operating systems support the more efficient __thread construct, which
@@ -52,6 +53,8 @@
 #endif
 
 struct ThreadLocalState {
+  /* Whether this thread was already attached to the JVM. */
+  bool threadCreatedFromJava;
   /* The JNIEnv associated with the current thread */
   JNIEnv *env;
   /* The last exception stack trace that occured on this thread */
